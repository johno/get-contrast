{
  "color": {
    "$type": "color",
    "white": { "$value": "#ffffff" },
    "gray": {
      "400": { "$value": "#9ca3af" },
      "600": { "$value": "#4b5563" },
      "900": { "$value": "#111827" }
    },
    "blue": { "400": { "$value": "#60a5fa" } }
  },
  "surface": {
    "default": { "$value": "{color.white}" }
  },
  "text": {
    "default": { "$value": "{color.gray.900}" },
    "secondary": { "$value": "{color.gray.600}" },
    "muted": { "$value": "{color.gray.400}" }
  },
  "link": {
    "default": { "$value": "{color.blue.400}" }
  }
}
