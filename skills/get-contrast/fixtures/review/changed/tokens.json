{
  "color": {
    "$type": "color",
    "white": {
      "$value": "#ffffff"
    },
    "gray": {
      "100": {
        "$value": "#f3f4f6"
      },
      "400": {
        "$value": "#9ca3af"
      },
      "600": {
        "$value": "#4b5563"
      },
      "900": {
        "$value": "#111827"
      }
    },
    "blue": {
      "600": {
        "$value": "#60a5fa"
      }
    }
  },
  "surface": {
    "default": {
      "$value": "{color.white}"
    },
    "raised": {
      "$value": "{color.gray.100}"
    }
  },
  "text": {
    "default": {
      "$value": "{color.gray.900}"
    },
    "secondary": {
      "$value": "{color.gray.600}"
    },
    "muted": {
      "$value": "{color.gray.600}"
    }
  },
  "button": {
    "background": {
      "$value": "{color.blue.600}"
    },
    "text": {
      "$value": "{color.white}"
    }
  }
}
