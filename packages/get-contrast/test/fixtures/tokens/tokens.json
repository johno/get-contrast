{
  "color": {
    "$type": "color",
    "white": { "$value": "#ffffff" },
    "neutral": {
      "50": { "$value": "#fafafa" },
      "400": { "$value": "#a3a3a3" },
      "500": { "$value": "#737373" },
      "600": { "$value": "#525252" },
      "900": { "$value": "#171717" }
    },
    "blue": { "500": { "$value": "#3b82f6" } }
  },
  "spacing": { "4": { "$type": "dimension", "$value": "16px" } },
  "surface": {
    "default": { "$value": "{color.white}" },
    "raised": { "$value": "{color.neutral.50}" }
  },
  "text": {
    "default": { "$value": "{color.neutral.900}" },
    "secondary": { "$value": "{color.neutral.600}" },
    "muted": { "$value": "{color.neutral.400}" },
    "subtle": { "$value": "#b0b0b0" }
  },
  "button": {
    "background": { "$value": "{color.blue.500}" },
    "text": { "$value": "#ffffff" }
  }
}
