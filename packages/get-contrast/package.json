{
  "name": "get-contrast",
  "version": "3.0.1",
  "description": "Get the contrast ratio and WCAG score between common CSS color types.",
  "main": "index.js",
  "types": "dist/index.d.ts",
  "files": [
    "cli.js",
    "cli-run.js",
    "index.js",
    "warnings.js",
    "dist"
  ],
  "bin": {
    "contrast": "./cli.js"
  },
  "scripts": {
    "build": "rm -rf dist && node scripts/build-ts.js && node scripts/build-cli.js",
    "typecheck": "node scripts/build-ts.js && tsc -p tsconfig.typecheck.json",
    "test": "bun test ./test/ && bun run test:compat",
    "test:compat": "bun test ./compat/ && GET_CONTRAST_NO_WARNINGS=1 bun test ./compat/",
    "compat:update": "node compat/generate.js",
    "prepack": "bun run build"
  },
  "repository": "johno/get-contrast",
  "keywords": [
    "wcag",
    "color",
    "contrast",
    "contrast-ratio"
  ],
  "author": "John Otander <johnotander@gmail.com> (http://johnotander.com/)",
  "license": "MIT",
  "dependencies": {
    "css-color-names": "1.0.1",
    "is-blank": "2.1.0",
    "is-named-css-color": "1.0.0",
    "rgb": "^0.1.0",
    "wcag-contrast": "3.0.0"
  }
}
