{
  "name": "get-contrast",
  "version": "3.0.1",
  "description": "Get the contrast ratio and WCAG score between common CSS color types.",
  "main": "index.js",
  "types": "types/index.d.ts",
  "files": [
    "cli.js",
    "cli-run.js",
    "index.js",
    "warnings.js",
    "types"
  ],
  "bin": {
    "contrast": "./cli.js"
  },
  "scripts": {
    "build": "node scripts/build-cli.js",
    "pretest": "node scripts/build-cli.js",
    "test": "bun test test && bun run test:compat",
    "test:compat": "bun test compat && GET_CONTRAST_NO_WARNINGS=1 bun test compat",
    "compat:update": "node compat/generate.js",
    "prepack": "node scripts/build-cli.js"
  },
  "repository": "johno/get-contrast",
  "keywords": [
    "wcag",
    "color",
    "contrast",
    "contrast-ratio"
  ],
  "author": "John Otander <johnotander@gmail.com> (http://johnotander.com/)",
  "license": "MIT",
  "dependencies": {
    "css-color-names": "1.0.1",
    "is-blank": "2.1.0",
    "is-named-css-color": "1.0.0",
    "rgb": "^0.1.0",
    "wcag-contrast": "3.0.0"
  }
}
